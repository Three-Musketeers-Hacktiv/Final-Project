<diagram id="register-login" name="6. Register dan Login"><mxGraphModel background="#f1f5f9" grid="0" page="1" pageWidth="1400" pageHeight="2100"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="heading" value="6. Register dan login username/password" vertex="1" parent="1" style="text;html=0;fontColor=#0f172a;fontSize=22;fontStyle=1;align=left;"><mxGeometry x="60" y="20" width="1200" height="60" as="geometry"/></mxCell><mxCell id="start" value="Buka aplikasi. Buat akun baru atau masuk dengan username/password." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;spacing=10;"><mxGeometry x="80" y="120" width="440" height="90" as="geometry"/></mxCell><mxCell id="register" value="Register: isi username, password dan konfirmasi password." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;spacing=10;"><mxGeometry x="80" y="260" width="440" height="90" as="geometry"/></mxCell><mxCell id="validate" value="Backend validasi; normalisasi username dengan trim dan huruf kecil." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;spacing=10;"><mxGeometry x="80" y="400" width="440" height="90" as="geometry"/></mxCell><mxCell id="valid" value="Input valid dan konfirmasi cocok?" vertex="1" parent="1" style="rhombus;whiteSpace=wrap;html=0;fillColor=#fef3c7;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;spacing=10;"><mxGeometry x="120" y="540" width="360" height="120" as="geometry"/></mxCell><mxCell id="invalid" value="Tampilkan kesalahan. Jangan menyimpan akun atau password asli." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fee2e2;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;spacing=10;"><mxGeometry x="820" y="555" width="440" height="90" as="geometry"/></mxCell><mxCell id="hash" value="Hash password menggunakan bcrypt; tidak mencatat password ke log." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;spacing=10;"><mxGeometry x="80" y="710" width="440" height="90" as="geometry"/></mxCell><mxCell id="insert" value="Insert User: username unik, passwordHash, timestamps, lastLoginAt null, history kosong, save null." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;spacing=10;"><mxGeometry x="80" y="850" width="440" height="90" as="geometry"/></mxCell><mxCell id="saved" value="Insert berhasil?" vertex="1" parent="1" style="rhombus;whiteSpace=wrap;html=0;fillColor=#fef3c7;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;spacing=10;"><mxGeometry x="120" y="990" width="360" height="120" as="geometry"/></mxCell><mxCell id="duplicate" value="Nama duplikat / penyimpanan gagal: tampilkan kesalahan. Jangan menimpa akun lama." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fee2e2;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;spacing=10;"><mxGeometry x="820" y="1005" width="440" height="90" as="geometry"/></mxCell><mxCell id="login" value="Login: pengguna memasukkan username dan password." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;spacing=10;"><mxGeometry x="80" y="1160" width="440" height="90" as="geometry"/></mxCell><mxCell id="verify" value="Normalisasi username; cari User; bcrypt.compare password terhadap passwordHash." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;spacing=10;"><mxGeometry x="80" y="1300" width="440" height="90" as="geometry"/></mxCell><mxCell id="match" value="Kredensial cocok?" vertex="1" parent="1" style="rhombus;whiteSpace=wrap;html=0;fillColor=#fef3c7;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;spacing=10;"><mxGeometry x="120" y="1440" width="360" height="120" as="geometry"/></mxCell><mxCell id="failed" value="Username atau password tidak sesuai. Tidak menerbitkan JWT; batasi percobaan." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fee2e2;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;spacing=10;"><mxGeometry x="820" y="1455" width="440" height="90" as="geometry"/></mxCell><mxCell id="session" value="Terbitkan JWT via jsonwebtoken; perbarui lastLoginAt / updatedAt. Hash tidak dikirim ke browser." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;spacing=10;"><mxGeometry x="80" y="1610" width="440" height="90" as="geometry"/></mxCell><mxCell id="dashboard" value="Tampilkan username. Mulai Game atau Lanjutkan save milik User._id dari JWT." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;spacing=10;"><mxGeometry x="80" y="1750" width="440" height="90" as="geometry"/></mxCell><mxCell id="logout" value="Logout: client buang JWT. Akun dan progres tersimpan tetap ada." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;spacing=10;"><mxGeometry x="80" y="1890" width="440" height="90" as="geometry"/></mxCell><mxCell id="edge0" value="Belum punya akun" edge="1" parent="1" source="start" target="register" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#64748b;fontColor=#0f172a;labelBackgroundColor=#ffffff;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge1" value="" edge="1" parent="1" source="register" target="validate" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#64748b;fontColor=#0f172a;labelBackgroundColor=#ffffff;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge2" value="" edge="1" parent="1" source="validate" target="v