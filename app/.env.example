# MongoDB Atlas (server-only)
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/
MONGODB_DB_NAME=city_defense_dev
MONGODB_CONNECT_TIMEOUT_MS=5000

# Authentication (server-only)
SESSION_COOKIE_NAME=city_defense_session
SESSION_TTL_SECONDS=604800
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=city-defense-api
JWT_AUDIENCE=city-defense-web
BCRYPT_SALT_ROUNDS=12
APP_ORIGIN=http://localhost:3000

# OpenAI event narrative (server-only)
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_MS=10000
OPENAI_MAX_RETRIES=1
OPENAI_MAX_OUTPUT_TOKENS=800
OPENAI_PROMPT_VERSION=event-v1

LOG_LEVEL=info
